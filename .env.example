# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# ======================== 1. PRIMARY LLM ========================
# Provider: openai | gemini | anthropic | nvidia
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Tùy chọn base_url cho OpenAI-compatible (để trống nếu dùng OpenAI trực tiếp)
# Ví dụ: https://api.deepseek.com/v1 | https://openrouter.ai/api/v1 | https://integrate.api.nvidia.com/v1
OPENAI_BASE_URL=

# ======================== 2. LLM FALLBACK 1 =====================
ENABLE_LLM_FALLBACK=true
LLM_FALLBACK_PROVIDER_1=gemini
LLM_FALLBACK_MODEL_1=gemini-2.5-flash
GEMINI_API_KEY=

# ======================== 3. LLM FALLBACK 2 =====================
LLM_FALLBACK_PROVIDER_2=nvidia
LLM_FALLBACK_MODEL_2=meta/llama-3.1-70b-instruct
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic (tùy chọn)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ===================== EMBEDDING CONFIG =========================
# Provider chính: gemini | nvidia | sentence_transformers | openai
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# NVIDIA NIM Embedding (OpenAI-compatible)
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Fallback cho Embedding khi provider chính lỗi (VD: Gemini bị rate limit -> Fallback sang NVIDIA)
ENABLE_EMBEDDING_FALLBACK=true
FALLBACK_EMBEDDING_PROVIDER=nvidia

# ===================== RETRIEVAL & OPTIONAL =====================
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.65


