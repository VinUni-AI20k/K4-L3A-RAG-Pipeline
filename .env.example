# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
# Chỉ cần khi torch < 2.6 (macOS Intel): bản safetensors của bge-m3 nằm ở refs/pr/130
EMBEDDING_MODEL_REVISION=refs/pr/130
# Để trống để tự chọn; đặt cpu nếu GPU MPS (macOS Intel) báo out of memory
EMBEDDING_DEVICE=cpu

# Evaluation (Task 11) — ragas judge, tách khỏi generator
EVAL_MODEL=gpt-4o-mini
EVAL_EMBEDDING_MODEL=text-embedding-3-small

# Reranker sau RRF (Task 12, bonus). RERANKER_ENABLED=1 để chatbot dùng config C
# (hybrid + RRF + cross-encoder); evaluation config B/C tự bật/tắt, không phụ thuộc cờ này.
RERANKER_ENABLED=1
# local (sentence-transformers CrossEncoder, chạy CPU/GPU) | jina (cần JINA_API_KEY)
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Để trống thì dùng EMBEDDING_DEVICE
RERANKER_DEVICE=

# HyDE (Task 14, bonus): LLM viết đoạn giả định theo văn phong tài liệu, nối vào
# query tìm kiếm. Tốn 1 lời gọi LLM mỗi query; config D của evaluation là C + HyDE.
HYDE_ENABLED=1

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.53
