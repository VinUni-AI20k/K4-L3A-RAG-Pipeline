# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: OpenAI API
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Ngưỡng thử nghiệm: 15 golden in-domain và 7 query out-of-domain (xem bước 7).
SCORE_THRESHOLD=0.62
