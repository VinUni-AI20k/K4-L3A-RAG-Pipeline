# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
# Chỉ cần khi torch < 2.6 (macOS Intel): bản safetensors của bge-m3 nằm ở refs/pr/130
EMBEDDING_MODEL_REVISION=refs/pr/130
# Để trống để tự chọn; đặt cpu nếu GPU MPS (macOS Intel) báo out of memory
EMBEDDING_DEVICE=cpu

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
