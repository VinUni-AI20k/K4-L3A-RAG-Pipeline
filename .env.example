# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Ngân sách thời gian cho một lần PageIndex fallback (giây), mặc định 25.
PAGEINDEX_TIMEOUT=

# RRF fusion: để trống dùng mặc định 60 theo paper gốc.
RRF_K=

# --- Bonus (mặc định tắt: test phải chạy offline) ---
# HyDE query expansion: sinh đoạn giả định để làm giàu vector truy vấn.
USE_HYDE=false
HYDE_TIMEOUT=10

# Cross-encoder rerank sau RRF.
USE_MODEL_RERANK=false
# local (sentence-transformers) | jina (cần JINA_API_KEY)
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
