# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Ngưỡng fallback, so với cosine score gốc của dense search (Task 9 đọc biến này).
# Hiệu chỉnh bằng query in-domain và out-of-domain: chạy src/run_evaluation.py
# rồi lấy suggested_threshold. Để trống thì dùng mặc định 0.3.
SCORE_THRESHOLD=
